# Copy to .env and adjust. Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

VIGIL_JWT_SECRET=change-me-to-a-long-random-string
VIGIL_INGEST_TOKEN=change-me-too
POSTGRES_PASSWORD=vigil

# Port the dashboard is published on
VIGIL_PORT=8080

# Seed N hours of synthetic history on first start (0 = start empty)
VIGIL_DEMO_BACKFILL_HOURS=24
# Benign background events per second generated on start (0 = off)
VIGIL_NOISE_EPS=0
# Set to false once your team's accounts exist
VIGIL_ALLOW_REGISTRATION=true
